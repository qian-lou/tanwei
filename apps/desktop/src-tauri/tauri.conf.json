{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "探微",
  "version": "0.3.0",
  "identifier": "dev.tanwei.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:renderer",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build:renderer",
    "frontendDist": "../dist/renderer"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "探微 — JVM Runtime Workbench",
        "width": 1440,
        "height": 900,
        "minWidth": 720,
        "minHeight": 680,
        "visible": false,
        "backgroundColor": "#0a0a0a",
        "theme": "Dark",
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost 'self'; object-src 'none'; base-uri 'none'; frame-src 'none'",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost 'self' http://127.0.0.1:5173 ws://127.0.0.1:5173; object-src 'none'",
      "capabilities": [
        "main"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "JVM Runtime Workbench",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../build-resources/jvm/": "jvm/",
      "../build-resources/runtime/": "runtime/",
      "../build-resources/licenses/": "licenses/"
    },
    "macOS": {
      "minimumSystemVersion": "13.3",
      "hardenedRuntime": true
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  }
}
