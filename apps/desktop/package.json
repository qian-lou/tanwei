{
  "name": "@tanwei/desktop",
  "version": "0.3.0",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "description": "Tanwei — self-contained JVM Runtime Workbench",
  "author": "Tanwei Project",
  "type": "module",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build:renderer": "vite build",
    "build": "node ../../scripts/generate-rust-contracts.mjs && tauri build --no-bundle",
    "dev:renderer": "vite",
    "dev": "node ../../scripts/generate-rust-contracts.mjs && tauri dev",
    "start": "npm run dev",
    "typecheck": "tsc --noEmit -p tsconfig.renderer.json && cargo check --manifest-path src-tauri/Cargo.toml",
    "test:unit": "cross-env NODE_OPTIONS=--experimental-sqlite vitest run",
    "test:unit:watch": "cross-env NODE_OPTIONS=--experimental-sqlite vitest",
    "test:host": "cargo test --manifest-path src-tauri/Cargo.toml --lib",
    "package:dir": "node ../../scripts/build-desktop-package.mjs",
    "package:test": "node ../../scripts/build-desktop-package.mjs --test",
    "package": "node ../../scripts/build-desktop-package.mjs"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tauri-apps/api": "^2.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.469.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.9.6",
    "recharts": "3.8.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.17",
    "tw-animate-css": "^1.4.0",
    "zod": "4.4.3",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.17",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "25.5.0",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "cross-env": "10.1.0",
    "happy-dom": "20.8.3",
    "typescript": "5.9.3",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
